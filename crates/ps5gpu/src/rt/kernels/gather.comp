// Copy `count` dwords of guest memory at `src` (through the page table) to
// the device address `dst` (diagnostics: dumps of guest BVHs as the GPU
// sees them).

#version 460
#include "guest.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform P {
    uint64_t src;
    uint64_t dst;
    uint count;
    uint page_bits;
    uint page_limit;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    Words(pc.dst).w[i] = GUEST_WORD(pc.src + uint64_t(i) * 4ul);
}
